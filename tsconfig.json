{
  "extends": "@tsconfig/node22/tsconfig.json",
  "compilerOptions": {
    // ESM: "module": "nodenext" plus "type": "module" in package.json means
    // tsc emits real ES modules, and relative imports need explicit .js
    // extensions (they refer to the emitted file, not the .ts source).
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    // TypeScript 7 no longer pulls in @types/* implicitly the way 5.x did,
    // so name what this package actually needs: Node globals (setInterval,
    // NodeJS.Timeout).
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
